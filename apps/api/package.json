{
  "name": "@interscale/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "doctor:weblink-pdf": "node scripts/weblink-pdf-preflight.cjs",
    "db:backfill-customers": "dotenv -e ../../.env -- tsx src/scripts/backfill-customers.ts",
    "db:backfill-search-api-keys": "dotenv -e ../../.env -- tsx src/scripts/backfill-search-api-keys.ts",
    "db:backfill-weblinks": "dotenv -e ../../.env -- tsx src/scripts/backfill-quotation-weblinks.ts",
    "reminders:process": "dotenv -e ../../.env -- tsx src/scripts/process-reminders.ts",
    "bootstrap:system-masters": "dotenv -e ../../.env -- tsx src/scripts/bootstrap-system-masters.ts",
    "clean": "rm -rf dist"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1106.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1106.0",
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@interscale/shared": "*",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.45.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "playwright": "1.55.1",
    "sanitize-html": "2.17.0",
    "sharp": "^0.35.3",
    "tldts": "^6.1.86",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
