/// A person who can sign in. Belongs to exactly one company.
model User {
  id                   String  @id @default(uuid()) @db.Uuid
  companyId            String  @db.Uuid
  roleId               String  @db.Uuid
  permissionTemplateId String? @db.Uuid

  /// Login handle, unique per company (not globally).
  username String @db.VarChar(40)
  fullName String @db.VarChar(120)

  /// Address as the user typed it, preserved for display.
  email           String  @db.VarChar(255)
  /// Lowercased, trimmed form used for lookup and uniqueness.
  ///
  /// GLOBALLY UNIQUE BY DESIGN: login accepts only email + password, with no
  /// tenant selector, so an address must resolve to exactly one account.
  /// Trade-off: one person cannot hold accounts at two agencies with the same
  /// address. Revisiting that would require a company selector at login.
  normalizedEmail String  @unique @db.VarChar(255)
  phone           String? @db.VarChar(32)

  /// Argon2id digest. No plaintext password is ever stored.
  passwordHash String @db.VarChar(255)

  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  /// Forces a password change on next sign-in (admin-created accounts).
  mustChangePassword Boolean @default(false)

  /// LEGACY single SearchAPI key (superseded by the SearchApiKey model).
  /// Kept so existing configured keys can be migrated by
  /// `src/scripts/backfill-search-api-keys.ts`; new keys live on SearchApiKey.
  searchApiKeyEncrypted  String? @db.Text
  searchApiKeyKeyVersion String? @db.VarChar(30)

  /// Brute-force controls, reset on every successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// When the password was last changed. Audit data, and a reference point for
  /// invalidating anything issued before a reset. Null for never-changed.
  passwordChangedAt DateTime?

  // Destination Expert — explicit gender for default avatar + expert profile details.
  // Gender is explicit; never inferred. Custom profile photo overrides gender avatar.
  gender                       UserGender?
  jobTitle                     String?          @db.VarChar(120)
  bio                          String?          @db.Text
  specialization               String?          @db.VarChar(200)
  yearsOfExperience            Int?
  tripsPlanned                 Int?
