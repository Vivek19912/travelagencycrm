/// A date-range rate for a hotel room type (e.g. "Summer", "Peak"). A room
/// type can have multiple seasons; at most one should cover any given date.
/// The room type's base `sellingPrice` applies when neither a monthly nor a
/// seasonal rate covers the travel date. `price`/`currency` keep the same shape
/// as other master prices so no conversion is ever performed.
model HotelRoomTypeSeason {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @db.Uuid
  hotelId              String   @db.Uuid
  hotelRoomTypeId      String   @db.Uuid
  name                 String   @db.VarChar(160)
  startDate            DateTime @db.Date
  endDate              DateTime @db.Date
  price                Decimal? @db.Decimal(14, 2)
  extraBedPrice        Decimal? @db.Decimal(14, 2)
  childWithoutBedPrice Decimal? @db.Decimal(14, 2)
  currency             String   @default("INR") @db.VarChar(3)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hotel    Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType HotelRoomType @relation(fields: [hotelRoomTypeId], references: [id], onDelete: Cascade)

  @@index([companyId, hotelRoomTypeId])
  @@index([hotelRoomTypeId, startDate, endDate])
  @@map("hotel_room_type_seasons")
}

/// A date-range rate for a hotel meal plan (e.g. "Summer", "Peak"). A meal
/// plan can have multiple seasons; at most one should cover any given date.
/// The meal plan's base `sellingPrice` applies when neither a monthly nor a
/// seasonal rate covers the travel date.
model HotelMealPlanSeason {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  hotelId         String   @db.Uuid
  hotelMealPlanId String   @db.Uuid
  name            String   @db.VarChar(160)
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  price           Decimal? @db.Decimal(14, 2)
  currency        String   @default("INR") @db.VarChar(3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hotel    Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  mealPlan HotelMealPlan @relation(fields: [hotelMealPlanId], references: [id], onDelete: Cascade)

  @@index([companyId, hotelMealPlanId])
  @@index([hotelMealPlanId, startDate, endDate])
  @@map("hotel_meal_plan_seasons")
}

/// An optional calendar-month price for a hotel (month 1 = January). Multiple
/// months may be configured; the base `price` applies when no monthly or
/// seasonal rate covers the travel date. `price`/`currency` keep the exact same
/// shape as the Hotel price so no conversion is ever performed.
model HotelMonthPrice {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  hotelId   String   @db.Uuid
  month     Int      @db.SmallInt
  price     Decimal? @db.Decimal(14, 2)
  currency  String   @default("INR") @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([companyId, hotelId, month])
  @@index([companyId, hotelId])
  @@map("hotel_month_prices")
}

/// An optional calendar-month price for a hotel room type. Multiple months may
/// be configured; the room type's base `sellingPrice` applies when no monthly
/// or seasonal rate covers the travel date.
model HotelRoomTypeMonthPrice {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @db.Uuid
  hotelId              String   @db.Uuid
  hotelRoomTypeId      String   @db.Uuid
  month                Int      @db.SmallInt
  price                Decimal? @db.Decimal(14, 2)
  extraBedPrice        Decimal? @db.Decimal(14, 2)
  childWithoutBedPrice Decimal? @db.Decimal(14, 2)
  currency             String   @default("INR") @db.VarChar(3)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hotel    Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType HotelRoomType @relation(fields: [hotelRoomTypeId], references: [id], onDelete: Cascade)

  @@unique([companyId, hotelRoomTypeId, month])
  @@index([companyId, hotelRoomTypeId])
  @@map("hotel_room_type_month_prices")
}

/// An optional calendar-month price for a hotel meal plan. Multiple months may
/// be configured; the meal plan's base `sellingPrice` applies when no monthly
/// or seasonal rate covers the travel date.
model HotelMealPlanMonthPrice {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  hotelId         String   @db.Uuid
  hotelMealPlanId String   @db.Uuid
  month           Int      @db.SmallInt
  price           Decimal? @db.Decimal(14, 2)
  currency        String   @default("INR") @db.VarChar(3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hotel    Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  mealPlan HotelMealPlan @relation(fields: [hotelMealPlanId], references: [id], onDelete: Cascade)

  @@unique([companyId, hotelMealPlanId, month])
  @@index([companyId, hotelMealPlanId])
  @@map("hotel_meal_plan_month_prices")
}

/// A date-range rate for a hotel (e.g. "Peak Season", "Summer"). A hotel can
/// have multiple seasons; at most one should cover any given date. Quotations
/// use the season whose range contains the stay's check-in date, falling back
/// to the hotel's base `price` when no season matches. `price`/`currency` keep
/// the exact same shape as the Hotel price so no conversion is ever performed.
model HotelSeason {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  hotelId   String   @db.Uuid
  name      String   @db.VarChar(160)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  price     Decimal? @db.Decimal(14, 2)
  currency  String   @default("INR") @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([companyId, hotelId])
  @@index([hotelId, startDate, endDate])
  @@map("hotel_seasons")
}

model Airline {
