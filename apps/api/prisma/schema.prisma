// ---------------------------------------------------------------------------
// Live Search bookmarks
// ---------------------------------------------------------------------------

/// A user-saved Live Search flight or hotel result. Stores a complete snapshot
/// of what the agent saw so the bookmark can be rendered later without calling
/// SearchAPI again. Scoped to the owning user and tenant.
model LiveSearchBookmark {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  userId       String   @db.Uuid
  /// FLIGHT or HOTEL.
  type         String   @db.VarChar(20)
  /// Provider constant, e.g. SEARCHAPI.
  provider     String   @db.VarChar(40)
  /// Stable identity of the saved result within the owning user's scope.
  fingerprint  String   @db.VarChar(160)
  /// Public, human-readable bookmark code, e.g. HTL-000123 or FLT-000456.
  bookmarkCode String   @unique @db.VarChar(20)
  /// Short human-readable title (e.g. "DEL → SIN" or the hotel name).
  title        String   @db.VarChar(300)
  currency     String   @db.VarChar(10)
  /// The search parameters that produced this result.
  searchParams Json
  /// The normalized + original provider snapshot used to render the bookmark.
  snapshot     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One bookmark per (user, result fingerprint). Repeated clicks are idempotent.
  @@unique([userId, fingerprint])
  @@index([companyId, type])
  @@index([companyId, userId, createdAt])
  @@index([userId, createdAt])
  @@map("live_search_bookmarks")
}

/// A user's saved SearchAPI.io API key for Live Search. Encrypted at rest with
/// AES-256-GCM (DATA_ENCRYPTION_KEY); the plaintext is never returned. Status
/// tracks quota/invalidity so exhausted keys are skipped without burning calls.
model SearchApiKey {
  id           String             @id @default(uuid()) @db.Uuid
  companyId    String             @db.Uuid
  userId       String             @db.Uuid
  /// AES-256-GCM envelope (version:iv:tag:ciphertext). Never exposed.
  encryptedKey String             @db.Text
  keyVersion   String             @db.VarChar(30)
  /// HMAC-SHA256 (TOKEN_PEPPER) digest of the trimmed key, for cheap duplicate checks.
  keyDigest    String             @db.VarChar(64)
  /// Last four characters of the trimmed key — the only identifier ever shown.
  maskedSuffix String             @db.VarChar(16)
  status       SearchApiKeyStatus @default(ACTIVE)
  /// Lower number wins; ties break on creation (insertion order).
  priority     Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  usage SearchApiUsage[]

  /// No duplicate identical keys for the same user.
  @@unique([userId, keyDigest])
  @@index([companyId, userId, status, priority])
  @@index([userId, priority])
  @@map("search_api_keys")
}

/// One row = one actual outbound request to SearchAPI.io. Written only around
/// the real provider call — never for frontend actions, bookmarks or cached
/// views. The Owner-only dashboard aggregates these rows per company.
model SearchApiUsage {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  userId            String   @db.Uuid
  searchApiKeyId    String?  @db.Uuid
  /// FLIGHT | HOTEL | AUTOCOMPLETE
  type              String   @db.VarChar(20)
  engine            String   @db.VarChar(60)
  /// SUCCESS | QUOTA_EXHAUSTED | INVALID_KEY | PROVIDER_ERROR | NETWORK_ERROR
  status            String   @db.VarChar(20)
  /// True when this attempt came after the first key failed (key fallback).
  isFallbackAttempt Boolean  @default(false)
  /// Last four characters of the key used — never the full key.
  maskedKeySuffix   String?  @db.VarChar(16)
  createdAt         DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchApiKey SearchApiKey? @relation(fields: [searchApiKeyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([searchApiKeyId])
  @@map("search_api_usage")
}

// ---------------------------------------------------------------------------
