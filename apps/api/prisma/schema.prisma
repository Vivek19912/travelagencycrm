  endDate                    DateTime?                 @db.Date
  confirmationStatus         ServiceConfirmationStatus @default(PENDING)
  confirmationNumber         String?                   @db.VarChar(255)
  supplierName               String?                   @db.VarChar(200)
  supplierReference          String?                   @db.VarChar(255)
  vendorNameSnapshot         String?                   @db.VarChar(200)
  vendorServiceSnapshot      String?                   @db.VarChar(200)
  supplierConfirmationNumber String?                   @db.VarChar(255)
  customerSellingAmount      Decimal                   @default(0) @db.Decimal(14, 2)
  internalCostSnapshot       Decimal                   @default(0) @db.Decimal(14, 2)
  // Snapshot of hotel extra pricing (mirrors QuotationVersionHotelOption, nullable).
  baseRoomPrice              Decimal?                  @db.Decimal(14, 2)
  extraBedQuantity           Int?
  extraBedPrice              Decimal?                  @db.Decimal(14, 2)
  childWithoutBedQuantity    Int?
  childWithoutBedPrice       Decimal?                  @db.Decimal(14, 2)
  pricingSource              String?                   @db.VarChar(20)
  cancellationCharge         Decimal                   @default(0) @db.Decimal(14, 2)
  refundedAmount             Decimal                   @default(0) @db.Decimal(14, 2)
  paymentDueAt               DateTime?
  cancellationDeadline       DateTime?
  notes                      String?                   @db.VarChar(2000)
  sequence                   Int
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  deletedAt                  DateTime?

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  booking        Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendor         Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorService  VendorService?    @relation(fields: [vendorServiceId], references: [id], onDelete: SetNull)
  hotel          Hotel?            @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  hotelRoomType  HotelRoomType?    @relation(fields: [hotelRoomTypeId], references: [id], onDelete: SetNull)
  hotelMealPlan  HotelMealPlan?    @relation(fields: [hotelMealPlanId], references: [id], onDelete: SetNull)
  airline        Airline?          @relation(fields: [airlineId], references: [id], onDelete: SetNull)
  cruise         Cruise?           @relation(fields: [cruiseId], references: [id], onDelete: SetNull)
  cruiseRoomType CruiseRoomType?   @relation(fields: [cruiseRoomTypeId], references: [id], onDelete: SetNull)
  vehicle        Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  sightseeing    Sightseeing?      @relation(fields: [sightseeingId], references: [id], onDelete: SetNull)
  addOnService   AddOnService?     @relation(fields: [addOnServiceId], references: [id], onDelete: SetNull)
  costs          BookingCost[]
  documents      BookingDocument[]
  vendorPayables VendorPayable[]
  reminders      QueryFollowUp[]

  @@unique([bookingId, sequence])
  @@index([companyId, bookingId, deletedAt])
  @@index([companyId, confirmationStatus])
  @@index([companyId, vendorId, deletedAt])
  @@index([hotelId])
  @@index([hotelRoomTypeId])
  @@index([hotelMealPlanId])
  @@index([airlineId])
  @@index([cruiseId])
  @@index([cruiseRoomTypeId])
  @@index([vehicleId])
  @@index([sightseeingId])
  @@index([addOnServiceId])
  @@map("booking_services")
}

