/// A reusable sightseeing attraction, tour, transfer or activity.
///
/// Scope follows the reference CRM's Sightseeing Master: reusable itinerary
/// content grouped by Destination and City. It is NOT a ticketing, inventory,
/// availability or guide-scheduling system, and it carries no pricing — the
/// reference form has no price field.
model Sightseeing {
  id            String @id @default(uuid()) @db.Uuid
  companyId     String @db.Uuid
  destinationId String @db.Uuid
  cityId        String @db.Uuid

  title           String @db.VarChar(250)
  /// Lower-cased title backing case-insensitive search.
  normalizedTitle String @db.VarChar(250)

  /// Manual ordering within a city. The reference restarts numbering per city
  /// and tolerates gaps, so this is not unique.
  sequence Int @default(1)

  /// Duration in hours, e.g. 2.5 for 2h30m. Nullable — often blank.
  estimatedHours     Decimal? @db.Decimal(5, 2)
  /// Recommended local start time as HH:mm. Stored as text because it is a
  /// wall-clock suggestion, not an instant.
  suggestedStartTime String?  @db.VarChar(5)

  /// Rich-text HTML from the editors.
  description String? @db.Text
  remarks     String? @db.Text

  imageStorageProvider  StorageProvider?
  imageBucket           String?          @db.VarChar(255)
  imageObjectKey        String?          @db.VarChar(1000)
  imageFileName         String?          @db.VarChar(255)
  imageMimeType         String?          @db.VarChar(120)
  imageFileSize         Int?
  imageConfirmedAt      DateTime?
  pendingImageObjectKey String?          @db.VarChar(1000)
  pendingImageFileName  String?          @db.VarChar(255)
  pendingImageMimeType  String?          @db.VarChar(120)
  pendingImageFileSize  Int?
  /// Ordered multi-image metadata. Legacy single-image columns remain the fallback.
  images                Json?            @db.Json
  /// Optional multi-category pricing (e.g. Adult, Child, Senior, custom).
  /// Stored as JSON array of { label, price }. All optional, display-only on master.
  pricing               Json?            @db.Json
  /// Default meals/transfer prefilled into quotation itinerary entries when
  /// this activity is selected: { meals: {breakfast,lunch,dinner},
  /// mealModes: {breakfast,lunch,dinner}, transfer }. Null = no defaults;
  /// legacy rows stay null and behave as before.
  mealDefaults          Json?            @db.Json

  status      MasterStatus @default(ACTIVE)
  createdById String       @db.Uuid
  updatedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Restrict: a destination or city still used by sightseeing content cannot
  // be removed out from under it.
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  city        City        @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("SightseeingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?       @relation("SightseeingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  quotationVersionServices  QuotationVersionService[]
  quotationTemplateServices QuotationTemplateService[]
  bookingServices           BookingService[]

  @@unique([companyId, cityId, normalizedTitle])
  @@index([companyId, status])
  @@index([companyId, destinationId, cityId, sequence])
  @@index([companyId, cityId, sequence])
  @@index([companyId, normalizedTitle])
  @@index([destinationId])
  @@index([cityId])
  @@index([createdById])
  @@index([updatedById])
  @@map("sightseeings")
}

/// A reusable optional extra sold alongside a trip (visa assistance, insurance,
/// arrival cards, ferry service…).
///
/// The reference form exposes exactly four fields — name, description, price
/// and an active toggle — so there is deliberately no category, pricing basis,
/// tax or internal cost here. Gallery images mirror the hotel/sightseeing
/// multi-image implementation.
model AddOnService {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @db.Uuid
  name           String  @db.VarChar(200)
  normalizedName String  @db.VarChar(200)
  /// Rich-text HTML from the description editor.
  description    String? @db.Text

  /// Single public price. Optional — empty means no prefilled price.
  /// Legacy single-price columns: kept for backward compatibility and kept
  /// in sync with the first pricing entry. The repeatable `pricing` list
  /// below is authoritative for new writes.
  price        Decimal? @db.Decimal(14, 2)
  currency     String   @default("INR") @db.VarChar(3)
  /// Free-text pricing basis shown with the price (e.g. "Per Person").
  pricingBasis String?  @db.VarChar(80)
  /// Repeatable pricing options, e.g. Adult/Child/Per Group. Ordered JSON
  /// array of { id, label, price, currency }; each entry carries a stable
  /// UUID so rows stay independently editable. Mirrors the master-images
  /// JSON pattern (structured data, never a formatted string).
  pricing               Json?            @db.Json

  imageStorageProvider  StorageProvider?
  imageBucket           String?          @db.VarChar(255)
  imageObjectKey        String?          @db.VarChar(1000)
  imageFileName         String?          @db.VarChar(255)
  imageMimeType         String?          @db.VarChar(120)
  imageFileSize         Int?
  imageConfirmedAt      DateTime?
  pendingImageObjectKey String?          @db.VarChar(1000)
  pendingImageFileName  String?          @db.VarChar(255)
  pendingImageMimeType  String?          @db.VarChar(120)
  pendingImageFileSize  Int?
  /// Ordered multi-image metadata. Legacy single-image columns remain the fallback.
  images                Json?            @db.Json

  status      MasterStatus @default(ACTIVE)
  createdById String       @db.Uuid
  updatedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("AddOnServiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("AddOnServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  quotationVersionServices  QuotationVersionService[]
  quotationTemplateServices QuotationTemplateService[]
  bookingServices           BookingService[]
  destinations              AddOnServiceDestination[]

  @@unique([companyId, normalizedName])
  @@index([companyId, status])
  @@index([companyId, normalizedName])
  @@index([createdById])
  @@index([updatedById])
  @@map("add_on_services")
}

/// Destination assignments for an add-on service master. Each link records
/// whether the service is a default for that destination (auto-added to new
/// quotations for the destination). The 20-defaults-per-destination cap is
/// enforced by the service layer.
model AddOnServiceDestination {
  id             String       @id @default(uuid()) @db.Uuid
  companyId      String       @db.Uuid
  addOnServiceId String       @db.Uuid
  destinationId  String       @db.Uuid
  /// Default for this destination: auto-added to new quotations using it.
  isDefault      Boolean      @default(false)
  sequence       Int
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  addOnService   AddOnService @relation(fields: [addOnServiceId], references: [id], onDelete: Cascade)
  destination    Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([addOnServiceId, destinationId])
  @@index([companyId, destinationId])
  @@map("add_on_service_destinations")
}

/// A reusable visa type tied to one destination, with an arbitrary number of
/// ordered rich-text sections (Overview, Visa Fees, Documents Required…). The
/// reference form exposes destination, name, an active toggle and the repeatable
/// sections — nothing else. Not linked to leads/quotations/bookings.
model VisaType {
  id             String @id @default(uuid()) @db.Uuid
  companyId      String @db.Uuid
  destinationId  String @db.Uuid
  name           String @db.VarChar(200)
  /// Lower-cased name backing case-insensitive search and the unique index.
  normalizedName String @db.VarChar(200)

  status      MasterStatus @default(ACTIVE)
  createdById String       @db.Uuid
  updatedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Restrict: a destination still used by a visa type cannot be removed.
  destination Destination       @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  createdBy   User              @relation("VisaTypeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?             @relation("VisaTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  sections    VisaTypeSection[]

  @@index([companyId, status])
  @@index([companyId, destinationId])
  @@index([companyId, normalizedName])
  @@index([destinationId])
  @@index([createdById])
  @@index([updatedById])
  @@map("visa_types")
}

/// One ordered rich-text section within a visa type.
model VisaTypeSection {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @db.Uuid
  visaTypeId String @db.Uuid
  title      String @db.VarChar(200)
  /// Sanitized rich-text HTML.
  content    String @db.Text
  sequence   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  visaType VisaType @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)

  @@index([companyId, visaTypeId])
  @@index([visaTypeId, sequence])
  @@map("visa_type_sections")
}

/// A customer testimonial/review. `destinationName` is deliberately free text
/// (the reference form is a plain input, not a destination selector). `isVisible`
/// is stored configuration only in this phase — no PDF/web publishing is wired.
model Testimonial {
  id              String  @id @default(uuid()) @db.Uuid
  companyId       String  @db.Uuid
  /// Optional — blank means an anonymous testimonial.
  clientName      String? @db.VarChar(160)
  destinationName String  @db.VarChar(200)
  description     String  @db.Text
  /// Marketing visibility flag (show on PDF quotations / web links). Stored only.
  isVisible       Boolean @default(true)

  imageStorageProvider  StorageProvider?
  imageBucket           String?          @db.VarChar(255)
  imageObjectKey        String?          @db.VarChar(1000)
  imageFileName         String?          @db.VarChar(255)
  imageMimeType         String?          @db.VarChar(120)
  imageFileSize         Int?
  imageConfirmedAt      DateTime?
  pendingImageObjectKey String?          @db.VarChar(1000)
  pendingImageFileName  String?          @db.VarChar(255)
  pendingImageMimeType  String?          @db.VarChar(120)
  pendingImageFileSize  Int?
  /// Ordered multi-image metadata. Legacy single-image columns remain the fallback.
  images                Json?            @db.Json

  status      MasterStatus @default(ACTIVE)
  createdById String       @db.Uuid
  updatedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TestimonialCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("TestimonialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("testimonials")
}

model Faq {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @db.Uuid
  question     String       @db.VarChar(500)
  answer       String       @db.Text
  /// Destinations this FAQ applies to. Empty array = applies to every destination.
  destinations Json?        @db.JsonB
  status       MasterStatus @default(ACTIVE)
  createdById  String       @db.Uuid
  updatedById  String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("FaqCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("FaqUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("faqs")
}

/// A cruise product offered to travellers, with its sellable room types.
///
/// Scope is deliberately narrow (Phase 13C): the reference CRM's Cruise Master
/// is a catalogue entry — name, description, image and room types. It is not an
/// itinerary, sailing-schedule or deck-plan engine.
model Cruise {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @db.Uuid
  name           String  @db.VarChar(200)
  /// Lower-cased name backing case-insensitive search and per-tenant uniqueness.
  normalizedName String  @db.VarChar(200)
  /// Rich-text HTML from the description editor.
  description    String? @db.Text

  // Private media. Mirrors the Hotel/Airline two-phase upload: the pending*
  // columns hold an approved-but-unconfirmed object until the client confirms.
  imageStorageProvider  StorageProvider?
  imageBucket           String?          @db.VarChar(255)
  imageObjectKey        String?          @db.VarChar(1000)
  imageFileName         String?          @db.VarChar(255)
  imageMimeType         String?          @db.VarChar(120)
  imageFileSize         Int?
  imageConfirmedAt      DateTime?
  pendingImageObjectKey String?          @db.VarChar(1000)
  pendingImageFileName  String?          @db.VarChar(255)
  pendingImageMimeType  String?          @db.VarChar(120)
  pendingImageFileSize  Int?
  /// Ordered multi-image metadata. Legacy single-image columns remain the fallback.
  images                Json?            @db.Json
  price                 Decimal?         @db.Decimal(14, 2)
  currency              String           @default("INR") @db.VarChar(3)

  status      MasterStatus @default(ACTIVE)
  createdById String       @db.Uuid
  updatedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User             @relation("CruiseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?            @relation("CruiseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  roomTypes CruiseRoomType[]

  quotationVersionServices  QuotationVersionService[]
  quotationTemplateServices QuotationTemplateService[]
  bookingServices           BookingService[]

  @@unique([companyId, normalizedName])
  @@index([companyId, status])
  @@index([companyId, normalizedName])
  @@index([createdById])
  @@index([updatedById])
  @@map("cruises")
}

/// A sellable cabin/room category on a cruise (Interior, Ocean View, Suite…).
model CruiseRoomType {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  cruiseId    String   @db.Uuid
  name        String   @db.VarChar(160)
  description String?  @db.VarChar(2000)
  /// Nullable: the reference allows a room type with no price yet, which is
  /// why the list can render "No pricing information available".
  price       Decimal? @db.Decimal(14, 2)
  currency    String   @default("INR") @db.VarChar(3)

  status    MasterStatus @default(ACTIVE)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Cascade: a room type has no meaning without its cruise, and cruises are
  // only ever soft-archived, so this never destroys historical data.
  cruise  Cruise  @relation(fields: [cruiseId], references: [id], onDelete: Cascade)

  quotationVersionServices  QuotationVersionService[]
  quotationTemplateServices QuotationTemplateService[]
  bookingServices           BookingService[]

  @@index([companyId, cruiseId])
  @@index([cruiseId, sortOrder])
  @@map("cruise_room_types")
}

/// A vehicle category offered for transfers and sightseeing.
///
/// This is a catalogue master (name/type/capacity), NOT fleet management: no
/// drivers, registrations, maintenance, GPS or scheduling.
model Vehicle {
  id             String  @id @default(uuid()) @db.Uuid
  companyId      String  @db.Uuid
  name           String  @db.VarChar(200)
  normalizedName String  @db.VarChar(200)
  /// Free text in the reference ("Luxury SUV", "AC Coach"); the list filter is
  /// built from the distinct values a tenant has actually used.
  vehicleType    String  @db.VarChar(120)
  /// Seats available to travellers. Nullable — the reference leaves it optional.
  capacity       Int?
  description    String? @db.Text

  imageStorageProvider  StorageProvider?
  imageBucket           String?          @db.VarChar(255)
  imageObjectKey        String?          @db.VarChar(1000)
  imageFileName         String?          @db.VarChar(255)
  imageMimeType         String?          @db.VarChar(120)
  imageFileSize         Int?
  imageConfirmedAt      DateTime?
  pendingImageObjectKey String?          @db.VarChar(1000)
  pendingImageFileName  String?          @db.VarChar(255)
  pendingImageMimeType  String?          @db.VarChar(120)
  pendingImageFileSize  Int?
  /// Ordered multi-image metadata. Legacy single-image columns remain the fallback.
  images                Json?            @db.Json
  price                 Decimal?         @db.Decimal(14, 2)
  currency              String           @default("INR") @db.VarChar(3)

  status      MasterStatus @default(ACTIVE)
  createdById String       @db.Uuid
  updatedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("VehicleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("VehicleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  destinations VehicleDestination[]

  quotationVersionServices  QuotationVersionService[]
  quotationTemplateServices QuotationTemplateService[]
  bookingServices           BookingService[]

  @@unique([companyId, normalizedName])
  @@index([companyId, status])
  @@index([companyId, vehicleType])
  @@index([companyId, normalizedName])
  @@index([createdById])
  @@index([updatedById])
  @@map("vehicles")
}

/// Destination assignments for a vehicle master (0–10 destinations).
/// The ordered link preserves the user's selection order; the destination
/// itself is resolved through the link so IDs stay authoritative.
model VehicleDestination {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  vehicleId     String   @db.Uuid
  destinationId String   @db.Uuid
  sequence      Int
  createdAt     DateTime @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, destinationId])
  @@index([companyId, destinationId])
  @@map("vehicle_destinations")
}

// ---------------------------------------------------------------------------
// Authorisation
// ---------------------------------------------------------------------------

/// A named set of permissions within one company.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  companyId   String  @db.Uuid
  name        String  @db.VarChar(60)
  description String? @db.VarChar(500)

  /// Higher wins. Used to stop a user assigning a role above their own.
  hierarchyLevel Int @default(0)

  /// System roles are seeded per company and protected from deletion.
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId, hierarchyLevel])
  @@map("roles")
}

/// The global permission catalogue. Not tenant scoped — the same keys exist
/// for every company; only the grants differ.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  /// `<module>.<action>`, e.g. `users.create`.
  key         String @unique @db.VarChar(80)
  module      String @db.VarChar(40)
  action      String @db.VarChar(40)
  description String @db.VarChar(500)

  /// False for modules that are planned but not built. Must never be granted.
  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())

  roles     RolePermission[]
  templates PermissionTemplatePermission[]

  @@index([module])
  @@index([isAvailable])
  @@map("permissions")
}

/// Join table: which permissions a role grants.
model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A reusable, company-scoped permission preset applied on top of a role.
model PermissionTemplate {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  name        String         @db.VarChar(60)
  description String?        @db.VarChar(500)
  status      TemplateStatus @default(ACTIVE)

  /// Nullable so removing the author does not remove the template.
  createdById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company     Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?                          @relation("PermissionTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  users       User[]
  permissions PermissionTemplatePermission[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@index([companyId, deletedAt])
  @@index([createdById])
  @@map("permission_templates")
}

/// Join table: which permissions a template grants.
model PermissionTemplatePermission {
  templateId   String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  template   PermissionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  permission Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([templateId, permissionId])
  @@index([permissionId])
  @@map("permission_template_permissions")
}

// ---------------------------------------------------------------------------
// Credentials — tenancy inherited through User
// ---------------------------------------------------------------------------

/// An authenticated browser session. Opaque server-backed token.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// SHA-256 of the raw token, which is only ever held by the client cookie.
  /// A database leak therefore cannot be replayed as a session.
  tokenHash String @unique @db.VarChar(64)

  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(512)

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// A one-time email-verification code. Hashed, single use, attempt limited.
model EmailVerificationOtp {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// Hash of the six-digit code. The plaintext OTP is never persisted.
  otpHash String @db.VarChar(64)

  expiresAt DateTime
  usedAt    DateTime?

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_verification_otps")
}

/// A single-use password-reset token. Hashed at rest.
model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  /// SHA-256 of the token embedded in the reset link.
  tokenHash String @unique @db.VarChar(64)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only audit trail, scoped to a company.
///
/// Actor and target are SetNull rather than Cascade: the record of what
/// happened must outlive the accounts involved.
model ActivityLog {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  /// Null for system-originated events with no signed-in actor.
  actorUserId  String? @db.Uuid
  /// Null when the action does not target a specific user.
  targetUserId String? @db.Uuid

  action     ActivityAction
  entityType String         @db.VarChar(40)
  entityId   String?        @db.Uuid

  /// Safe contextual detail only. Never credentials, tokens, OTPs or full
  /// request bodies.
  metadata Json?

  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(512)

  createdAt DateTime @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUser  User?   @relation("ActivityLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User?   @relation("ActivityLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, action])
  @@index([companyId, actorUserId])
  @@index([companyId, entityType])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Customer profiles — canonical identity and cross-module relationship hub
// ---------------------------------------------------------------------------

model CustomerCounter {
  companyId String  @db.Uuid
  year      Int
  value     Int     @default(0)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, year])
  @@map("customer_counters")
}

model Customer {
  id                     String                     @id @default(uuid()) @db.Uuid
  companyId              String                     @db.Uuid
  customerNumber         String                     @db.VarChar(24)
  type                   CustomerType               @default(INDIVIDUAL)
  status                 CustomerStatus             @default(ACTIVE)
  lifecycleStage         CustomerLifecycleStage     @default(PROSPECT)
  displayName            String                     @db.VarChar(160)
  normalizedName         String                     @db.VarChar(160)
  primaryPhone           String?                    @db.VarChar(32)
  normalizedPhone        String?                    @db.VarChar(24)
  alternatePhone         String?                    @db.VarChar(32)
  email                  String?                    @db.VarChar(255)
  normalizedEmail        String?                    @db.VarChar(255)
  dateOfBirth            DateTime?                  @db.Date
  anniversaryDate        DateTime?                  @db.Date
  companyName            String?                    @db.VarChar(160)
  taxIdentification      String?                    @db.VarChar(80)
  preferredContactMethod CustomerCommunicationType?
  preferredCurrency      String                     @default("INR") @db.VarChar(3)
  preferredLanguage      String?                    @db.VarChar(40)
  travelPreferences      String?                    @db.VarChar(4000)
  dietaryRequirements    String?                    @db.VarChar(2000)
  specialRequirements    String?                    @db.VarChar(2000)
  source                 String?                    @db.VarChar(80)
  assignedToId           String?                    @db.Uuid
  createdById            String                     @db.Uuid
  mergedIntoId           String?                    @db.Uuid
  queryCount             Int                        @default(0)
  quotationCount         Int                        @default(0)
  bookingCount           Int                        @default(0)
  completedBookingCount  Int                        @default(0)
  totalBookedValue       Decimal                    @default(0) @db.Decimal(14, 2)
  totalPaid              Decimal                    @default(0) @db.Decimal(14, 2)
  totalOutstanding       Decimal                    @default(0) @db.Decimal(14, 2)
  lifetimeGrossProfit    Decimal                    @default(0) @db.Decimal(14, 2)
  isRepeatCustomer       Boolean                    @default(false)
  isVip                  Boolean                    @default(false)
  customerSince          DateTime                   @default(now())
  lastContactedAt        DateTime?
  lastEnquiryAt          DateTime?
  lastInteractionAt      DateTime?
  lastBookingAt          DateTime?
  nextFollowUpAt         DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  deletedAt              DateTime?

  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedTo       User?                   @relation("CustomerAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy        User                    @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  mergedInto       Customer?               @relation("CustomerMergeTarget", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedSources    Customer[]              @relation("CustomerMergeTarget")
  addresses        CustomerAddress[]
  tagAssignments   CustomerTagAssignment[]
  notes            CustomerNote[]
  communications   CustomerCommunication[]
  documents        CustomerDocument[]
  queries          Query[]
  quotations       Quotation[]
  bookings         Booking[]
  mergeHistoryFrom CustomerMergeHistory[]  @relation("CustomerMergeSource")
  mergeHistoryInto CustomerMergeHistory[]  @relation("CustomerMergeTargetHistory")
  reminders        QueryFollowUp[]
  calls            Call[]
  hotelVouchers    HotelVoucher[]
  paymentCases     PaymentCase[]

  @@unique([companyId, customerNumber])
  @@index([companyId, normalizedPhone, deletedAt])
  @@index([companyId, normalizedEmail, deletedAt])
  @@index([companyId, normalizedName, deletedAt])
  @@index([companyId, assignedToId, deletedAt])
  @@index([companyId, status, lifecycleStage, deletedAt])
  @@index([companyId, isRepeatCustomer, isVip, deletedAt])
  @@index([companyId, createdAt])
  @@map("customers")
}

model CustomerAddress {
  id         String              @id @default(uuid()) @db.Uuid
  companyId  String              @db.Uuid
  customerId String              @db.Uuid
  type       CustomerAddressType @default(HOME)
  label      String?             @db.VarChar(80)
  line1      String              @db.VarChar(255)
  line2      String?             @db.VarChar(255)
  city       String              @db.VarChar(120)
  state      String?             @db.VarChar(120)
  postalCode String?             @db.VarChar(24)
  country    String              @db.VarChar(80)
  isPrimary  Boolean             @default(false)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  deletedAt  DateTime?
  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, customerId, deletedAt])
  @@map("customer_addresses")
}

model CustomerTag {
  id             String                  @id @default(uuid()) @db.Uuid
  companyId      String                  @db.Uuid
  name           String                  @db.VarChar(60)
  normalizedName String?                 @db.VarChar(60)
  color          String                  @default("#64748b") @db.VarChar(7)
  description    String?                 @db.VarChar(500)
  createdById    String?                 @db.Uuid
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments    CustomerTagAssignment[]

  @@unique([companyId, name])
  @@unique([companyId, normalizedName])
  @@index([companyId, createdAt])
  @@map("customer_tags")
}

model CustomerTagAssignment {
  companyId    String      @db.Uuid
  customerId   String      @db.Uuid
  tagId        String      @db.Uuid
  assignedById String?     @db.Uuid
  createdAt    DateTime    @default(now())
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
