model Quotation {
  id                     String          @id @default(uuid()) @db.Uuid
  companyId              String          @db.Uuid
  customerId             String?         @db.Uuid
  quotationNumber        String          @db.VarChar(24)
  queryId                String          @db.Uuid
  sourceTemplateId       String?         @db.Uuid
  createdById            String          @db.Uuid
  currentVersionId       String?         @db.Uuid
  acceptedVersionId      String?         @db.Uuid
  publicVersionId        String?         @db.Uuid
  status                 QuotationStatus @default(DRAFT)
  customerName           String          @db.VarChar(120)
  customerEmail          String?         @db.VarChar(255)
  customerPhone          String          @db.VarChar(32)
  destinationSummary     String          @db.VarChar(500)
  travelStartDate        DateTime?       @db.Date
  travelEndDate          DateTime?       @db.Date
  adults                 Int             @default(1)
  childrenWithBed        Int             @default(0)
  childrenWithoutBed     Int             @default(0)
  infants                Int             @default(0)
  rooms                  Int             @default(1)
  // Child ages carried from the Lead (or edited on the quotation) — the single
  // source the PDF and Weblink both render. NULL for legacy quotations.
  childrenWithBedAges    Json?
  childrenWithoutBedAges Json?
  infantAges             Json?
  // Traveller names carried from the Lead (or edited on the quotation) for
  // email drafts. Positional string arrays parallel to the passenger counts;
  // blanks stay blank. NULL for legacy quotations.
  adultNames             Json?
  childWithBedNames      Json?
  childWithoutBedNames   Json?
  infantNames            Json?
  currency               String          @default("INR") @db.VarChar(3)
  validUntil             DateTime?       @db.Date
  publicTokenHash        String?         @unique @db.VarChar(64)
  // Raw public token used to reconstruct the weblink URL (the public route
  // looks it up by its hash). Cleared on revoke. Kept tenant-side only.
  publicToken            String?         @db.VarChar(64)
  publicTokenExpiresAt   DateTime?
  // Friendly customer-facing weblink alias (e.g. "mohan-singapore") for the
  // apex domain `travelagencycrm.in/<publicSlug>`. Globally unique across every
  // tenant; nullable so pre-existing quotations need no backfill. Changing it
  // never regenerates the public token.
  publicSlug             String?         @unique @db.VarChar(60)
  firstSentAt            DateTime?
  lastSentAt             DateTime?
  firstViewedAt          DateTime?
  lastViewedAt           DateTime?
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?         @db.VarChar(2000)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  deletedAt              DateTime?

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  query          Query                  @relation(fields: [queryId], references: [id], onDelete: Restrict)
  sourceTemplate QuotationTemplate?     @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  createdBy      User                   @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  versions       QuotationVersion[]
  documents      QuotationDocument[]
  emailLogs      QuotationEmailLog[]
  booking        Booking?
  reminders      QueryFollowUp[]
  weblinkViews   QuotationWeblinkView[]

  @@unique([companyId, quotationNumber])
  @@index([companyId, queryId, deletedAt])
  @@index([companyId, customerId, deletedAt])
  @@index([companyId, status, deletedAt])
  @@index([companyId, createdById, deletedAt])
  @@index([companyId, validUntil])
  @@map("quotations")
}

/// Aggregated public-weblink view per quotation + normalized IP (Phase: weblink
/// analytics). One row per IP so counts are O(1) to read and no unbounded event
/// stream is ever loaded.
model QuotationWeblinkView {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @db.Uuid
  quotationId   String          @db.Uuid
  ipAddress     String          @db.VarChar(64)
  type          WeblinkViewType @default(EXTERNAL)
  viewCount     Int             @default(1)
  firstViewedAt DateTime        @default(now())
  lastViewedAt  DateTime        @updatedAt

  // Rich visitor snapshot (best-effort; the latest visit overwrites). All
  // optional — populated by the public /track beacon + server IP/UA enrichment.
  userAgent          String?  @db.Text
  browser            String?  @db.VarChar(60)
  browserVersion     String?  @db.VarChar(40)
  os                 String?  @db.VarChar(60)
  osVersion          String?  @db.VarChar(40)
  deviceType         String?  @db.VarChar(20)
  deviceVendor       String?  @db.VarChar(60)
  deviceModel        String?  @db.VarChar(80)
  country            String?  @db.VarChar(80)
  region             String?  @db.VarChar(80)
  city               String?  @db.VarChar(80)
  isp                String?  @db.VarChar(120)
  geoTimezone        String?  @db.VarChar(60)
  latitude           Float?
  longitude          Float?
  platform           String?  @db.VarChar(60)
  language           String?  @db.VarChar(20)
  languages          String?  @db.Text
  clientTimezone     String?  @db.VarChar(60)
  screenWidth        Int?
  screenHeight       Int?
  screenAvailWidth   Int?
  screenAvailHeight  Int?
  viewportWidth      Int?
  viewportHeight     Int?
  pixelRatio         Float?
  colorDepth         Int?
  orientation        String?  @db.VarChar(24)
  cpuCores           Int?
  deviceMemory       Float?
  connectionType     String?  @db.VarChar(20)
  connectionDownlink Float?
  connectionRtt      Int?
  online             Boolean?
  referrer           String?  @db.Text
  landingUrl         String?  @db.Text
  utmSource          String?  @db.VarChar(120)
  utmMedium          String?  @db.VarChar(120)
  utmCampaign        String?  @db.VarChar(120)
  visitorId          String?  @db.VarChar(60)
  maxScrollDepth     Int?
  timeOnPageSeconds  Int?
  ctaClicks          Int?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, ipAddress])
  @@index([companyId, quotationId])
  @@index([quotationId, lastViewedAt])
  @@map("quotation_weblink_views")
}

enum WeblinkViewType {
  HOME
  EXTERNAL
}

model QuotationVersion {
  id                           String                 @id @default(uuid()) @db.Uuid
  companyId                    String                 @db.Uuid
  quotationId                  String                 @db.Uuid
  versionNumber                Int
  title                        String                 @db.VarChar(200)
  introduction                 String?                @db.VarChar(4000)
  weblinkHeading               String?                @db.VarChar(200)
  /// Custom package heading for the third line of the public weblink hero
  /// (destination / duration / package heading). Null for legacy versions,
  /// which fall back to "Custom Package for [Lead]".
  packageHeading               String?                @db.VarChar(200)
  /// Custom duration text for the public weblink hero + profile card,
  /// overriding the generated "N Nights / N+1 Days". Null for legacy
  /// versions, which keep the generated text. Display-only.
  weblinkDurationText          String?                @db.VarChar(200)
  /// Custom destination text for the public weblink profile card,
  /// overriding the generated destinations. Null for legacy versions, which
  /// keep the generated text. Display-only.
  weblinkProfileDestination    String?                @db.VarChar(500)
  /// Per-item label/value/visibility overrides for the public weblink profile
  /// information card (Weblink Display Settings). Nullable for backward
  /// compatibility; null/absent keeps the fully automatic card. Display-only —
  /// never a source of lead/business data.
  weblinkProfile               Json?                  @db.Json
  destinationSummary           String                 @db.VarChar(500)
  travelStartDate              DateTime?              @db.Date
  travelEndDate                DateTime?              @db.Date
  currency                     String                 @db.VarChar(3)
  subtotalCost                 Decimal                @default(0) @db.Decimal(14, 2)
  subtotalSellingPrice         Decimal                @default(0) @db.Decimal(14, 2)
  markupMode                   MarkupMode             @default(NONE)
  markupValue                  Decimal                @default(0) @db.Decimal(14, 4)
  totalMarkup                  Decimal                @default(0) @db.Decimal(14, 2)
  taxRate                      Decimal                @default(0) @db.Decimal(8, 4)
  taxAmount                    Decimal                @default(0) @db.Decimal(14, 2)
  discountAmount               Decimal                @default(0) @db.Decimal(14, 2)
  finalAmount                  Decimal                @default(0) @db.Decimal(14, 2)
  marginAmount                 Decimal                @default(0) @db.Decimal(14, 2)
  marginPercentage             Decimal                @default(0) @db.Decimal(8, 4)
  pricingMode                  PricingMode            @default(ITEMIZED)
  /// Customer-facing pricing heading ("Price Breakdown" by default).
  pricingHeading               String                 @default("Price Breakdown") @db.VarChar(120)
  /// Optional customer-facing pricing subheading; empty means hidden.
  pricingSubheading            String?                @db.VarChar(200)
  /// Ordered pricing category ids for the section-wise presentation.
  pricingDisplayOrder          Json?                  @db.Json
  // Reference "Summary & Pricing" — per-passenger package pricing.
  perAdultPrice                Decimal                @default(0) @db.Decimal(14, 2)
  perChildWithBedPrice         Decimal                @default(0) @db.Decimal(14, 2)
  perChildWithoutBedPrice      Decimal                @default(0) @db.Decimal(14, 2)
  perInfantPrice               Decimal                @default(0) @db.Decimal(14, 2)
  /// Additional flat-price line items for By Traveler (PER_PERSON) pricing.
  /// Ordered JSON array of { id?: string; label: string; amount: number } — each
  /// amount is a fixed package charge, never multiplied by the traveler count.
  packageCustomItems           Json?                  @db.Json
  /// Builder-only By Traveler Price Breakdown row order (stable row ids:
  /// traveler keys adults/cwb/cwob/infants plus custom item ids).
  pricingRowOrder              Json?                  @db.Json
  taxNote                      String?                @db.VarChar(200)
  netAmount                    Decimal                @default(0) @db.Decimal(14, 2)
  initialPaymentAmount         Decimal                @default(0) @db.Decimal(14, 2)
  paymentLink                  String?                @db.VarChar(500)
  showServiceChargesSeparately Boolean                @default(false)
  markServiceChargesOutside    Boolean                @default(false)
  hidePricing                  Boolean                @default(false)
  showIndividualPricing        Boolean                @default(false)
  // Weblink "Quick Navigation" section index. Shown by default; sticky opt-in.
  showQuickNav                 Boolean                @default(true)
  quickNavSticky               Boolean                @default(false)
  // Reference "Inclusions & Exclusions" — rich-text/HTML blocks. TEXT (not
  // VARCHAR) because HTML markup makes these legitimately exceed 8000 chars.
  inclusionsHtml               String?                @db.Text
  exclusionsHtml               String?                @db.Text
  paymentPolicies              String?                @db.VarChar(8000)
  cancellationPolicies         String?                @db.VarChar(8000)
  // Booking Terms & Conditions — TEXT (not VARCHAR) because detailed travel
  // booking terms legitimately exceed 8000 chars with HTML markup. The 20,000
  // app-level limit lives in QUOTATION_BOOKING_TERMS_MAX_LENGTH (shared).
  bookingTerms                 String?                @db.Text
  childPolicy                  String?                @db.VarChar(8000)
  // Reference "Visa" — single dedicated section.
  includeVisa                  Boolean                @default(true)
  visaSectionTitle             String?                @db.VarChar(200)
  visaAmount                   Decimal                @default(0) @db.Decimal(14, 2)
  visaDestination              String?                @db.VarChar(120)
  visaType                     String?                @db.VarChar(120)
  visaServiceCharge            Decimal                @default(0) @db.Decimal(14, 2)
  visaGstPercent               Decimal                @default(0) @db.Decimal(8, 4)
  visaVfsCharge                Decimal                @default(0) @db.Decimal(14, 2)
  // Reference "Flight" — structured journeys/segments (section title, amount,
  // journey type, outbound & return legs). Stored as JSON; see flightDetailsSchema.
  flightDetails                Json?
  // Reference "Sightseeing" — day-wise itinerary of activities (attraction,
  // start time, description, image, meals, transfer). Stored as JSON.
  sightseeingDetails           Json?
  // Reference "Hotel" — editable section title, amount and description.
  hotelDetails                 Json?
  // Reference "Add-on Services" — top-level include flag (the individual
  // add-ons are persisted as service rows; unchecked rows are omitted).
  addOnDetails                 Json?
  // Weblink customization: quotation-specific FAQs and custom section order.
  // `faqs` is an ordered array of { question, answer }; `weblinkSectionOrder`
  // is an ordered list of section ids. Both are nullable for backward compatibility.
  faqs                         Json?                  @db.Json
  weblinkSectionOrder          Json?                  @db.Json
  // Destination Expert — per-quotation config (nullable for old quotations)
  destinationExpertConfig      Json?                  @db.Json
  // Stylish PDF Page 1 — hero + three gallery card selections. Nullable for
  // backward compatibility; absent means all defaults (destination hero +
  // first images of the first three different sightseeing activities).
  stylishPdfPage1              Json?                  @db.Json
  notes                        String?                @db.VarChar(4000)
  internalNotes                String?                @db.VarChar(4000)
  status                       QuotationVersionStatus @default(DRAFT)
  finalizedAt                  DateTime?
  createdById                  String                 @db.Uuid
  createdAt                    DateTime               @default(now())

  company    Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotation  Quotation                      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  createdBy  User                           @relation("QuotationVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  itinerary  QuotationVersionItineraryDay[]
  hotels     QuotationVersionHotelOption[]
  services   QuotationVersionService[]
  inclusions QuotationVersionInclusion[]
  exclusions QuotationVersionExclusion[]
  terms      QuotationVersionTerm[]
  documents  QuotationDocument[]
  emailLogs  QuotationEmailLog[]
  booking    Booking?

  @@unique([quotationId, versionNumber])
  @@index([companyId, quotationId])
  @@map("quotation_versions")
}

