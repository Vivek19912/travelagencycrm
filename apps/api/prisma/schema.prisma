  // Lead-based "Create Booking from Lead" fields.
  title                    String?              @db.VarChar(200)
  tcsExempt                Boolean              @default(false)
  gstRate                  Int?
  gstMode                  String?              @db.VarChar(16)
  placeOfSupply            String?              @db.VarChar(80)
