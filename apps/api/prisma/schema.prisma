// ---------------------------------------------------------------------------
// Call recordings — Android telephony integration (Phase 10)
// ---------------------------------------------------------------------------

enum CallDirection {
  INCOMING
  OUTGOING
  UNKNOWN
}

enum CallMatchStatus {
  EXACT_MATCH
  NEEDS_REVIEW
  NO_MATCH
}

enum CallRecordingStatus {
  NOT_UPLOADED
  UPLOADING
  UPLOADED
  FAILED
  RETRY_REQUIRED
}

model Call {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @db.Uuid
  userId               String              @db.Uuid
  customerId           String?             @db.Uuid
  queryId              String?             @db.Uuid
  androidCallSessionId String              @db.VarChar(64)
  phone                String              @db.VarChar(32)
  normalizedPhone      String              @db.VarChar(24)
  direction            CallDirection
  startedAt            DateTime
  endedAt              DateTime?
  durationSeconds      Int?
  matchStatus          CallMatchStatus     @default(NO_MATCH)
  recordingStatus      CallRecordingStatus @default(NOT_UPLOADED)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer  Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  query     Query?         @relation(fields: [queryId], references: [id], onDelete: SetNull)
  recording CallRecording?

  @@unique([companyId, androidCallSessionId])
  @@index([companyId, normalizedPhone])
  @@index([companyId, startedAt])
  @@index([companyId, queryId])
  @@index([companyId, customerId])
  @@map("calls")
}

model CallRecording {
  id               String   @id @default(uuid()) @db.Uuid
  callId           String   @unique @db.Uuid
  companyId        String   @db.Uuid
  s3Key            String   @db.VarChar(1000)
  s3Bucket         String   @db.VarChar(255)
  mimeType         String   @db.VarChar(120)
  sizeBytes        Int
  durationMs       Int?
  sha256           String   @db.VarChar(128)
  originalFilename String   @db.VarChar(255)
  uploadedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  call    Call    @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([companyId, s3Key])
  @@map("call_recordings")
}

/// Server-to-server integration credential (e.g. WACRM lead sync).
/// The raw secret is shown once at mint time and never stored: only
/// its SHA-256 hash persists, mirroring the Session convention, so a
/// database leak cannot be replayed. Requests present
/// `wacrm_<prefix>.<secret>` as a Bearer token; the prefix selects
/// the row, the hash comparison is constant-time.
model IntegrationCredential {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  /// Human label shown in settings (never secret).
  name String @db.VarChar(120)

  /// First 12 chars of the presented token: indexed row selector.
  keyPrefix String @db.VarChar(16)
  /// SHA-256 hex of the full presented token.
  keyHash   String @unique @db.VarChar(64)

  /// Service identity the credential acts as. Tenant and actor for
  /// every integration call derive from this row — never from the
  /// request. Deleting the user revokes the credential's power
  /// (auth rejects); deleting is preferred over orphaning.
  userId      String  @db.Uuid
  createdById String? @db.Uuid

  expiresAt  DateTime?
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation("IntegrationCredentialUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([companyId, keyPrefix])
  @@index([companyId, revokedAt])
  @@map("integration_credentials")
}

/// Idempotency record for one WACRM lead → Travel CRM lead sync.
/// The unique key is the WACRM-side identity; a retry carrying the
/// same key returns the stored queryId instead of creating again.
/// queryId stays NULL until creation succeeds — a NULL here must
/// never render as "created".
model WacrmLeadLink {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  /// Opaque WACRM identifiers (WACRM account + flow run). Stored as
  /// text so no cross-database foreign key is implied.
  wacrmAccountId String @db.VarChar(64)
  flowRunId      String @db.VarChar(64)

  queryId String? @db.Uuid
  status  String  @default("pending") @db.VarChar(16)
  error   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  query   Query?  @relation(fields: [queryId], references: [id], onDelete: SetNull)

  @@unique([companyId, wacrmAccountId, flowRunId])
  @@index([companyId, status])
  @@map("wacrm_lead_links")
}

/// Lifecycle of a standalone Hotel Voucher (independent of Booking).
enum HotelVoucherStatus {
  DRAFT
  ISSUED
  CANCELLED
}

/// Sex marker for Hotel Voucher guest rows. Voucher-scoped literals
/// (M/F), distinct from the MALE/FEMALE UserGender user-profile enum.
enum HotelVoucherGuestSex {
  M
  F
}

/// Guest category for Hotel Voucher guest rows.
enum HotelVoucherGuestPaxType {
  ADULT
  CHILD
}

/// Per-company lifetime counter for voucher numbers (mirrors
/// QuotationCounter). `year` is always 0 — one compact sequence.
model HotelVoucherCounter {
  companyId String  @db.Uuid
  year      Int
  value     Int     @default(0)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, year])
  @@map("hotel_voucher_counters")
}

/// Standalone hotel service-confirmation voucher. All guest/hotel/stay
/// content is snapshotted at write time: later Hotel Master, Customer or
/// Lead changes must never rewrite an issued voucher. Optional
/// customerId/queryId/hotelId are selection conveniences only (SetNull).
model HotelVoucher {
  id                 String            @id @default(uuid()) @db.Uuid
  companyId          String            @db.Uuid
  voucherNumber      String            @db.VarChar(24)
  status             HotelVoucherStatus @default(DRAFT)
  issueDate          DateTime?         @db.Date
  customerId         String?           @db.Uuid
  queryId            String?           @db.Uuid
  hotelId            String?           @db.Uuid
  guestName          String            @db.VarChar(160)
  guestPhone         String?           @db.VarChar(32)
  guestEmail         String?           @db.VarChar(255)
  adults             Int               @default(1)
  children           Int               @default(0)
  hotelName          String            @db.VarChar(200)
  hotelAddress       String?           @db.VarChar(1000)
  hotelCity          String?           @db.VarChar(100)
  hotelPhone         String?           @db.VarChar(40)
  hotelEmail         String?           @db.VarChar(255)
  hotelStarRating    String?           @db.VarChar(20)
  checkIn            DateTime          @db.Date
  checkOut           DateTime          @db.Date
  roomTypeName       String?           @db.VarChar(160)
  rooms              Int               @default(1)
  mealPlanName       String?           @db.VarChar(160)
  confirmationNumber String?           @db.VarChar(80)
  /// Optional external booking reference typed by staff (e.g. an OTA or
  /// supplier booking id). Free text only — never a relation to Booking and
  /// never confused with confirmationNumber.
  bookingId          String?           @db.VarChar(80)
  /// Optional staff-customized display labels for the two reference fields
  /// above. NULL/blank means the built-in defaults ("Confirmation Number",
  /// "Booking ID"). Labels never alter the stored reference values.
  confirmationNumberLabel String?      @db.VarChar(80)
  bookingIdLabel     String?           @db.VarChar(80)
  specialRequests    String?           @db.VarChar(2000)
  remarks            String?           @db.VarChar(2000)
  termsSnapshot      String?           @db.Text
  createdById        String            @db.Uuid
  updatedById        String?           @db.Uuid
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  cancelledAt        DateTime?
  deletedAt          DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  query     Query?     @relation(fields: [queryId], references: [id], onDelete: SetNull)
  hotel     Hotel?     @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  createdBy User       @relation("HotelVoucherCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?      @relation("HotelVoucherUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  documents HotelVoucherDocument[]
  pricing   HotelVoucherPricing[]
  guests    HotelVoucherGuest[]
  packageIncludes HotelVoucherPackageInclude[]
  stayRooms HotelVoucherStayRoom[]
  stayMeals HotelVoucherStayMeal[]

  @@unique([companyId, voucherNumber])
  @@index([companyId, status, deletedAt])
  @@index([companyId, guestName])
  @@index([companyId, hotelName])
  @@index([companyId, checkIn])
  @@index([createdById])
  @@map("hotel_vouchers")
}

/// Optional pricing rows owned by a Hotel Voucher. All values are manually
/// entered snapshots (no calculation engine); sequence preserves row order.
/// Replaced wholesale on update; cascade-deleted with the voucher.
model HotelVoucherPricing {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  voucherId  String   @db.Uuid
  sequence   Int      @default(0)
  roomType   String   @db.VarChar(160)
  unit       Int      @default(1)
  quantity   Int      @default(1)
  gst        Decimal? @db.Decimal(5, 2)
  amount     Decimal? @db.Decimal(14, 2)
  taxablePay Decimal? @db.Decimal(14, 2)
  gstService Decimal? @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher HotelVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([companyId, voucherId, sequence])
  @@map("hotel_voucher_pricing")
}

/// Optional guest rows owned by a Hotel Voucher. Snapshot data, independent
/// of Customer/Lead masters. Replaced wholesale on update; cascade-deleted
/// with the voucher.
model HotelVoucherGuest {
  id        String                @id @default(uuid()) @db.Uuid
  companyId String                @db.Uuid
  voucherId String                @db.Uuid
  sequence  Int                   @default(0)
  guestName String                @db.VarChar(160)
  age       Int?
  sex       HotelVoucherGuestSex
  paxType   HotelVoucherGuestPaxType @default(ADULT)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher HotelVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([companyId, voucherId, sequence])
  @@map("hotel_voucher_guests")
}

/// Optional package-includes items owned by a Hotel Voucher. Plain snapshot
/// strings (e.g. "Breakfast"); sequence preserves item order. Replaced
/// wholesale on update; cascade-deleted with the voucher.
model HotelVoucherPackageInclude {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  voucherId String   @db.Uuid
  sequence  Int      @default(0)
  item      String   @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher HotelVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([companyId, voucherId, sequence])
  @@map("hotel_voucher_package_includes")
}

/// Room configurations snapshotted onto a Hotel Voucher from a quotation
/// hotel option (or entered manually): one row per room allocation with its
/// own type, quantity, and remark. Sequence preserves the quotation's line
/// order. Replaced wholesale on update; cascade-deleted with the voucher.
/// The voucher's scalar `rooms` stays the document's stated total and
/// `roomTypeName` mirrors the first row for legacy readers.
model HotelVoucherStayRoom {
  id                      String  @id @default(uuid()) @db.Uuid
  companyId               String  @db.Uuid
  voucherId               String  @db.Uuid
  sequence                Int     @default(0)
  roomType                String  @db.VarChar(160)
  rooms                   Int     @default(1)
  extraBedQuantity        Int?
  /// Retained for backward compatibility with vouchers saved before room
  /// remarks left the voucher workflow. No longer written or read.
  notes                   String? @db.VarChar(2000)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher HotelVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([companyId, voucherId, sequence])
  @@map("hotel_voucher_stay_rooms")
}

/// Meal-plan selections snapshotted onto a Hotel Voucher. Sequence preserves
/// the quotation's selection order. Replaced wholesale on update;
/// cascade-deleted with the voucher. The scalar `mealPlanName` mirrors the
/// first row for legacy readers.
model HotelVoucherStayMeal {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  voucherId String   @db.Uuid
  sequence  Int      @default(0)
  mealPlan  String   @db.VarChar(160)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher HotelVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([companyId, voucherId, sequence])
  @@map("hotel_voucher_stay_meals")
}

/// Stored generated PDFs for a voucher (mirrors the BookingDocument
/// generated-document subset). One reusable row per file name.
model HotelVoucherDocument {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @db.Uuid
  voucherId       String             @db.Uuid
  documentType    String             @default("VOUCHER") @db.VarChar(40)
  storageProvider StorageProvider
  bucket          String             @db.VarChar(255)
  objectKey       String             @db.VarChar(1000)
  fileName        String             @db.VarChar(255)
  mimeType        String             @db.VarChar(120)
  fileSize        Int
  checksum        String?            @db.VarChar(128)
  uploadStatus    DocumentStatus     @default(PENDING)
  visibility      DocumentVisibility @default(INTERNAL)
  uploadedById    String             @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher    HotelVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  uploadedBy User         @relation("HotelVoucherDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([companyId, objectKey])
  @@index([companyId, voucherId, deletedAt])
  @@map("hotel_voucher_documents")
}
