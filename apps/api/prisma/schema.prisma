/// One row = one global Master record that a tenant has hidden for its own
/// company. The original record is never modified; this table only suppresses
/// it from that tenant's lists and selectors. Deleting the row restores it.
model CompanyHiddenMaster {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  /// Stable internal master identifier, e.g. CITY or HOTEL. Never a label.
  masterType     String    @db.VarChar(40)
  /// Id of the hidden global record, scoped by masterType.
  masterId       String    @db.Uuid
  hiddenByUserId String?   @db.Uuid
  hiddenAt       DateTime  @default(now())
  /// Set when the tenant restores the record; non-null rows are inactive.
  restoredAt     DateTime?

  tenant   Company @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hiddenBy User?   @relation(fields: [hiddenByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, masterType, masterId])
  @@index([tenantId, masterType])
  @@index([masterType, masterId])
  @@index([hiddenByUserId])
  @@map("company_hidden_masters")
}

