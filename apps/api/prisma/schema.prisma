// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

/// A travel agency. The tenant boundary for every other table.
model Company {
  id                    String           @id @default(uuid()) @db.Uuid
  name                  String           @db.VarChar(120)
  /// URL-safe identifier derived from the name. Globally unique.
  slug                  String           @unique @db.VarChar(140)
  email                 String           @db.VarChar(255)
  phone                 String?          @db.VarChar(32)
  website               String?          @db.VarChar(255)
  address               String?          @db.VarChar(1000)
  /// Public Google Maps link for the agency (Settings → Company Profile).
  /// Shown as "View on Google Maps" in the weblink Contact Us section.
  /// Optional; legacy rows keep null (row hidden).
  googleMapsUrl         String?          @db.VarChar(2000)
  primaryColor          String           @default("#2563eb") @db.VarChar(7)
  /// Optional hotel-voucher PDF theme override (Settings → Branding).
  /// NULL (and any invalid value) falls back to the built-in purple theme,
  /// so legacy companies render exactly as before. Never affects quotation,
  /// booking, or other document themes.
  hotelVoucherPrimaryColor String?        @db.VarChar(7)
  // Confirmed company logo (Phase 18). Metadata columns mirror the master-image
  // pattern; pendingLogoObjectKey holds an unconfirmed upload so replacing a
  // logo never loses the current one until the new upload is confirmed.
  logoObjectKey         String?          @db.VarChar(1000)
  pendingLogoObjectKey  String?          @db.VarChar(1000)
  logoBucket            String?          @db.VarChar(255)
  logoStorageProvider   StorageProvider?
  logoMimeType          String?          @db.VarChar(120)
  logoFileSize          Int?
  logoConfirmedAt       DateTime?
