/// A verified/active hostname associated with exactly one Company. Phase 1 of
/// the Custom Domain feature: this is the secure data model + hostname→tenant
/// resolver only. No DNS/SSL/verification is modelled yet.
model CustomDomain {
  id        String             @id @default(uuid()) @db.Uuid
  companyId String             @db.Uuid
  /// Lower-cased, protocol/path/port-free hostname (e.g. "crm.easytour.com").
  hostname  String             @unique @db.VarChar(253)
  status    CustomDomainStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Phase 3 provisioning fields. certificateArn is never exposed to customer
  // UI; only the DNS records the customer must create are surfaced.
  certificateArn             String?   @db.VarChar(2048)
  certificateValidationName  String?   @db.VarChar(253)
  certificateValidationValue String?   @db.VarChar(253)
  dnsVerifiedAt              DateTime?
  activatedAt                DateTime?
  lastCheckedAt              DateTime?
  lastError                  String?   @db.VarChar(500)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // One current custom-domain record per company in Phase 1. Replacing a domain
  // updates this row rather than inserting a second one.
  @@unique([companyId])
  @@index([status])
  @@map("custom_domains")
}

/// The company's own bank account for customer invoices (Phase 18). One per
/// company. The account number is encrypted at rest with the shared encryption
/// service; only the last four digits are ever returned or printed.
model CompanyBankAccount {
  id                     String   @id @default(uuid()) @db.Uuid
  companyId              String   @unique @db.Uuid
  accountHolderName      String   @db.VarChar(200)
  bankName               String   @db.VarChar(200)
  branchName             String?  @db.VarChar(200)
  accountNumberEncrypted String   @db.Text
  accountNumberLast4     String   @db.VarChar(4)
  encryptionKeyVersion   String   @db.VarChar(30)
  ifscCode               String?  @db.VarChar(20)
  swiftCode              String?  @db.VarChar(20)
  accountType            String?  @db.VarChar(40)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_bank_accounts")
}

