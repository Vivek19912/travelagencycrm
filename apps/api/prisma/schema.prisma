model BookingRefund {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @db.Uuid
  bookingId        String        @db.Uuid
  bookingPaymentId String?       @db.Uuid
  refundNumber     String        @db.VarChar(24)
  amount           Decimal       @db.Decimal(14, 2)
  currency         String        @db.VarChar(3)
  refundMethod     PaymentMethod
  status           RefundStatus  @default(PROCESSED)
  reason           String        @db.VarChar(2000)
  processedAt      DateTime
  notes            String?       @db.VarChar(2000)
  recordedById     String        @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  reversedAt       DateTime?
  reversedById     String?       @db.Uuid
  reversalReason   String?       @db.VarChar(2000)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bookingPayment BookingPayment? @relation(fields: [bookingPaymentId], references: [id], onDelete: SetNull)
  recordedBy     User            @relation("BookingRefundRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  reversedBy     User?           @relation("BookingRefundReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  @@unique([companyId, refundNumber])
  @@index([companyId, bookingId, createdAt])
  @@index([companyId, status])
  @@map("booking_refunds")
}

/// Generated payment receipt document for a single BookingPayment. A receipt
/// is a document, not a financial transaction: amounts, method and balances
/// always come from the linked BookingPayment/Booking rows at render time.
/// At most one receipt row exists per payment (paymentId is unique); the
/// receiptNumber is a stable company-scoped RCP sequence. If the payment is
/// edited, the PDF bytes are regenerated under the same receipt number; a
/// reversed (or otherwise non-collected) payment has no valid receipt.
model BookingPaymentReceipt {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String           @db.Uuid
  bookingId      String           @db.Uuid
  paymentId      String           @unique @db.Uuid
  receiptNumber  String           @db.VarChar(24)
  fileName       String           @db.VarChar(255)
  storageProvider StorageProvider
  bucket         String           @db.VarChar(255)
  objectKey      String           @db.VarChar(1000)
  mimeType       String           @db.VarChar(120)
  fileSize       Int
  checksum       String?          @db.VarChar(128)
  uploadStatus   DocumentStatus   @default(PENDING)
  visibility     DocumentVisibility @default(CUSTOMER_VISIBLE)
  uploadedById   String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment    BookingPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation("BookingPaymentReceiptUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([companyId, receiptNumber])
  @@unique([companyId, objectKey])
  @@index([companyId, bookingId, createdAt])
  @@map("booking_payment_receipts")
}

/// Company-scoped counters for the standalone Payments module (mirrors
/// BookingCounter). One lifetime sequence per company; `year` is always 0.
model PaymentCounter {
  companyId    String  @db.Uuid
  year         Int
  paymentValue Int     @default(0)
  receiptValue Int     @default(0)
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, year])
  @@map("payment_counters")
}

/// Standalone collection context: one customer's trip with its own agreed
/// trip amount. Independent of Booking — payments against a case exist and
/// balance purely from this row plus its CustomerPayment rows. The customer
/// master link is preferred; the name snapshot keeps history readable when
/// the master is absent or later removed. Same for the optional lead link.
model PaymentCase {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  customerId    String?  @db.Uuid
  queryId       String?  @db.Uuid
  customerName  String   @db.VarChar(160)
  customerPhone String?  @db.VarChar(32)
  customerEmail String?  @db.VarChar(255)
  title         String   @db.VarChar(200)
  tripAmount    Decimal  @db.Decimal(14, 2)
  currency      String   @db.VarChar(3)
  createdById   String   @db.Uuid
  updatedById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  query     Query?     @relation(fields: [queryId], references: [id], onDelete: SetNull)
  createdBy User       @relation("PaymentCaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?      @relation("PaymentCaseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  payments  CustomerPayment[]

  @@index([companyId, customerId])
  @@index([companyId, queryId])
  @@index([companyId, customerName])
  @@index([companyId, createdAt])
  /// One payment case per lead per company. Nullable queryId rows are
  /// unaffected: PostgreSQL treats NULLs as distinct in unique constraints,
  /// so standalone (lead-less) cases can still repeat.
  @@unique([companyId, queryId])
  @@map("payment_cases")
}

/// Standalone customer payment against a PaymentCase. The ONLY financial
/// source of truth for the Payments module: no Booking, no bookingId, no
/// duplicated balances. Reversed/failed rows are excluded from collection
/// math by every aggregation (see payments.service).
model CustomerPayment {
  id                String              @id @default(uuid()) @db.Uuid
  companyId         String              @db.Uuid
  caseId            String              @db.Uuid
  paymentNumber     String              @db.VarChar(24)
  amount            Decimal             @db.Decimal(14, 2)
  currency          String              @db.VarChar(3)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentRecordStatus @default(RECEIVED)
  receivedAt        DateTime
  referenceNumber   String?             @db.VarChar(255)
  bankName          String?             @db.VarChar(200)
  notes             String?             @db.VarChar(2000)
  recordedById      String              @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  reversedAt        DateTime?
  reversedById      String?             @db.Uuid
  reversalReason    String?             @db.VarChar(2000)

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paymentCase PaymentCase     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  recordedBy User             @relation("CustomerPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  reversedBy User?            @relation("CustomerPaymentReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  receipt    PaymentReceipt?

  @@unique([companyId, paymentNumber])
  @@index([companyId, caseId, createdAt])
  @@index([companyId, receivedAt])
  @@map("customer_payments")
}

/// Generated payment voucher document for a single CustomerPayment. A
/// document, not a transaction: at most one row per payment (paymentId is
/// unique) and the receiptNumber is a stable company-scoped RCP sequence
/// from PaymentCounter — never the Booking counters.
model PaymentReceipt {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String             @db.Uuid
  paymentId       String             @unique @db.Uuid
  receiptNumber   String             @db.VarChar(24)
  fileName        String             @db.VarChar(255)
  storageProvider StorageProvider
  bucket          String             @db.VarChar(255)
  objectKey       String             @db.VarChar(1000)
  mimeType        String             @db.VarChar(120)
  fileSize        Int
  checksum        String?            @db.VarChar(128)
  uploadStatus    DocumentStatus     @default(PENDING)
  visibility      DocumentVisibility @default(CUSTOMER_VISIBLE)
  uploadedById    String             @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment    CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation("PaymentReceiptUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([companyId, receiptNumber])
  @@unique([companyId, objectKey])
  @@index([companyId, createdAt])
  @@map("payment_receipts")
}

/// Company-level sending account for standalone email. The SMTP password is
/// stored only as an AES-256-GCM envelope (see CompanyBankAccount for the
/// same pattern) and is never returned by any read API.
model CompanyEmailConfiguration {
  id                    String        @id @default(uuid()) @db.Uuid
  companyId             String        @unique @db.Uuid
  provider              EmailProvider @default(CUSTOM_SMTP)
  smtpHost              String        @db.VarChar(255)
  smtpPort              Int           @default(587)
  security              EmailSecurity @default(STARTTLS)
  smtpUsername          String        @db.VarChar(255)
  smtpPasswordEncrypted String        @db.Text
  passwordKeyVersion    String?       @db.VarChar(16)
  passwordSetAt         DateTime?
  fromName              String        @db.VarChar(160)
  fromEmail             String        @db.VarChar(255)
  replyTo               String?       @db.VarChar(255)
  createdById           String        @db.Uuid
  updatedById           String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("CompanyEmailConfigurationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("CompanyEmailConfigurationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("company_email_configurations")
}

/// Standalone sent-email log. Intentionally free of CRM foreign keys
/// (no booking/payment/lead/customer links in Phase 1): an email records
/// only who it went to, what it said, and whether the SMTP send succeeded.
model EmailLog {
  id           String      @id @default(uuid()) @db.Uuid
  companyId    String      @db.Uuid
  fromName     String?     @db.VarChar(160)
  fromEmail    String      @db.VarChar(255)
  to           String[]
  cc           String[]    @default([])
  bcc          String[]    @default([])
  subject      String      @db.VarChar(500)
  bodyHtml     String      @db.Text
  bodyText     String      @db.Text
  status       EmailStatus @default(SENDING)
  errorMessage String?     @db.Text
  sentAt       DateTime?
  createdById  String      @db.Uuid
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("EmailLogCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@map("email_logs")
}

