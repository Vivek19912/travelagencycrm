  vendorServiceId            String?                   @db.Uuid
  // Phase-15 travel-master references, mirroring QuotationVersionService so the
  // links a quotation carried survive conversion. All optional; the snapshot
  // columns below remain the authoritative rendered values.
  hotelId                    String?                   @db.Uuid
  hotelRoomTypeId            String?                   @db.Uuid
  hotelMealPlanId            String?                   @db.Uuid
  airlineId                  String?                   @db.Uuid
  cruiseId                   String?                   @db.Uuid
  cruiseRoomTypeId           String?                   @db.Uuid
  vehicleId                  String?                   @db.Uuid
  sightseeingId              String?                   @db.Uuid
