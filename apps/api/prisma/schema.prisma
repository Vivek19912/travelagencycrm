model QuotationVersionService {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @db.Uuid
  quotationVersionId String           @db.Uuid
  serviceType        ServiceType
  // Optional master references (Phase 14). Snapshot columns below stay
  // authoritative: these link a row to its catalogue entry without ever
  // becoming the source of rendered text or price.
  airlineId          String?          @db.Uuid
  cruiseId           String?          @db.Uuid
  cruiseRoomTypeId   String?          @db.Uuid
  /// Nights for a cruise stay; NULL for legacy rows and non-cruise services.
  cruiseNights       Int?
  /// Ordered room allocations inside ONE cruise service (JSON array of
  /// { cruiseRoomTypeId, roomType, rooms, roomRate, sellingPrice,
  /// internalCost, notes }); NULL for legacy rows, which keep using the
  /// scalar columns. An explicitly saved [] means "no rooms" and must stay
  /// roomless on reload.
  cruiseRoomLines    Json?            @db.Json
  vehicleId          String?          @db.Uuid
  sightseeingId      String?          @db.Uuid
  addOnServiceId     String?          @db.Uuid
  name               String           @db.VarChar(200)
  description        String?          @db.Text
  dayNumber          Int?
  city               String?          @db.VarChar(120)
  quantity           Decimal          @default(1) @db.Decimal(10, 2)
  unitCost           Decimal          @default(0) @db.Decimal(14, 2)
  unitSellingPrice   Decimal          @default(0) @db.Decimal(14, 2)
  totalCost          Decimal          @default(0) @db.Decimal(14, 2)
  totalSellingPrice  Decimal          @default(0) @db.Decimal(14, 2)
  // What the unit selling price represents (PER_DAY/PER_HOUR/PER_TRANSFER/
  // PER_VEHICLE/PER_TRAVELER/PER_UNIT/FIXED). NULL keeps legacy semantics.
  pricingBasis       String?          @db.VarChar(20)
  /// Free-text master pricing basis snapshot (e.g. "Per Person") carried
  /// from the Add-On Service master. NULL for legacy rows and other types.
  pricingBasisLabel  String?          @db.VarChar(80)
  /// Quotation-owned snapshot of ALL master pricing options available when
  /// the Add-On Service was selected. Ordered JSON array of
  /// { id, label, price, currency }; NULL for legacy rows and other types.
  /// Quotation-owned: later master edits never rewrite it.
  pricingSnapshot    Json?            @db.Json
  taxCategory        String?          @db.VarChar(80)
  notes              String?          @db.VarChar(2000)
  /// Vehicle "Duration" free text, independent from `notes` (Usage).
  duration           String?          @db.VarChar(2000)
  /// Ordered, quotation-owned image snapshot copied from a selected Master.
  images             Json?            @db.Json
  /// Exactly one saved image selected for PDF; falls back to the first image.
  pdfImageUrl        String?          @db.VarChar(1000)
  sequence           Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotationVersion   QuotationVersion @relation(fields: [quotationVersionId], references: [id], onDelete: Cascade)
  // SetNull everywhere: archiving or deleting a master must never destroy or
  // rewrite a saved quotation line.
  airline            Airline?         @relation(fields: [airlineId], references: [id], onDelete: SetNull)
  cruise             Cruise?          @relation(fields: [cruiseId], references: [id], onDelete: SetNull)
  cruiseRoomType     CruiseRoomType?  @relation(fields: [cruiseRoomTypeId], references: [id], onDelete: SetNull)
  vehicle            Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  sightseeing        Sightseeing?     @relation(fields: [sightseeingId], references: [id], onDelete: SetNull)
  addOnService       AddOnService?    @relation(fields: [addOnServiceId], references: [id], onDelete: SetNull)

  @@unique([quotationVersionId, sequence])
  @@index([companyId, quotationVersionId])
  @@index([companyId, serviceType])
  @@index([airlineId])
  @@index([cruiseId])
  @@index([cruiseRoomTypeId])
  @@index([vehicleId])
  @@index([sightseeingId])
  @@index([addOnServiceId])
  @@map("quotation_version_services")
}

