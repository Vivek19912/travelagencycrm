#####################################################################
# Interscale Travel CRM - environment template
#
# Copy to `.env` at the repo root:   cp .env.example .env
# NEVER commit a real `.env`. NEVER put production secrets here.
#
# PRODUCTION REQUIREMENTS (enforced at boot by apps/api/src/config/env.ts):
#   - NODE_ENV=production
#   - SESSION_SECRET, TOKEN_PEPPER: >=32 chars, real random values (no "change_me")
#   - API_URL, WEB_URL: must use https://
#   - EMAIL_PROVIDER=smtp with SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD set
#   - EMAIL_FROM: a real deliverable domain (NOT a ".local" placeholder)
#   - STORAGE_PROVIDER=s3 with AWS_S3_BUCKET and AWS_REGION set
#   - AWS creds: set BOTH AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, or NEITHER
#     (neither => an IAM role / default credential chain is used)
#   - DATA_ENCRYPTION_KEY: base64 32-byte key; DATA_ENCRYPTION_KEY_VERSION set
#   - VITE_API_URL: the PUBLIC https API URL, baked into the web bundle at build
#   Manage all real secrets in a secrets manager (AWS Secrets Manager / SSM),
#   never in a committed file. See docs/production/ for the full runbooks.
#####################################################################

# --- Runtime -------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Networking ----------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
# Quotation-friendly apex domain that hosts friendly quotation slugs
# (`https://yourquotation.in/<publicSlug>`). Distinct from WEB_URL (CRM app)
# and from the marketing site (travelagencycrm.in). Falls back here when
# a company has no ACTIVE custom domain.
PUBLIC_SLUG_BASE_URL=https://yourquotation.in

# Additional first-party hostnames that serve the SAME CRM app deployment as
# WEB_URL (comma-separated). They are trusted by request-host and origin/CORS
# validation and reserved so a customer custom domain can never claim them.
# Example: serve the CRM on both app.travelagencycrm.in and
# demo.travelagencycrm.in from one deployment.
PLATFORM_ALIAS_HOSTS=

# --- Database ------------------------------------------------------
# Must match the credentials in docker-compose.yml
POSTGRES_USER=interscale
POSTGRES_PASSWORD=interscale_dev_password
POSTGRES_DB=interscale_crm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://interscale:interscale_dev_password@localhost:5432/interscale_crm?schema=public

# Integration tests run against a SEPARATE database so they never truncate dev
# data. Created automatically on first `npm run test:api`. The name must end
# with `_test` or the suite refuses to start.
TEST_DATABASE_URL=postgresql://interscale:interscale_dev_password@localhost:5432/interscale_crm_test?schema=public

# --- Sessions ------------------------------------------------------
SESSION_COOKIE_NAME=interscale_sid
# Generate a real value with: openssl rand -base64 48
SESSION_SECRET=change_me_dev_session_secret_at_least_32_chars_long
TOKEN_PEPPER=change_me_dev_token_pepper_at_least_32_chars_long
SESSION_EXPIRY_HOURS=12
REMEMBER_ME_EXPIRY_DAYS=30

# --- Email OTP verification ---------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- Password reset ------------------------------------------------
PASSWORD_RESET_EXPIRY_MINUTES=30

# --- Account lockout -----------------------------------------------
# Consecutive failed sign-ins before an account is temporarily locked.
LOGIN_MAX_FAILED_ATTEMPTS=50
LOGIN_LOCKOUT_MINUTES=15

# --- CSRF ----------------------------------------------------------
# The double-submit CSRF token is delivered in this (JS-readable) cookie and
# echoed back in this header. Safe to expose: the token authorises nothing on
# its own. See apps/api/src/middleware/csrf.ts.
CSRF_COOKIE_NAME=interscale_csrf
CSRF_HEADER_NAME=x-csrf-token

# --- Email delivery ------------------------------------------------
# `console` prints emails (incl. dev OTP + reset link) to the API log.
#   Non-production only — env validation rejects it when NODE_ENV=production.
# `smtp`    delivers via SMTP_* below. Required in production.
# `memory`  collects mail in-process for tests only (NODE_ENV=test).
EMAIL_PROVIDER=console
EMAIL_FROM="Travel CRM <no-reply@interscale.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Private document storage -------------------------------------
# Use `memory` for local development/tests, `s3` in production. On AWS, prefer
# an IAM role and leave static key variables blank.
STORAGE_PROVIDER=memory
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_SERVER_SIDE_ENCRYPTION=AES256
AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=300
MAX_UPLOAD_SIZE_MB=10

# --- Booking documents and sensitive traveller data ----------------
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=v1
BOOKING_DOCUMENT_MAX_UPLOAD_SIZE_MB=15
BOOKING_PRESIGNED_URL_EXPIRY_SECONDS=300
PASSPORT_EXPIRY_WARNING_MONTHS=6
CUSTOMER_DOCUMENT_MAX_UPLOAD_SIZE_MB=10
CUSTOMER_DOCUMENT_PRESIGNED_URL_EXPIRY_SECONDS=300
VENDOR_DOCUMENT_MAX_UPLOAD_SIZE_MB=15
VENDOR_DOCUMENT_PRESIGNED_URL_EXPIRY_SECONDS=300
DESTINATION_IMAGE_MAX_UPLOAD_SIZE_MB=4
DESTINATION_IMAGE_PRESIGNED_URL_EXPIRY_SECONDS=300
HOTEL_IMAGE_MAX_UPLOAD_SIZE_MB=5
AIRLINE_LOGO_MAX_UPLOAD_SIZE_MB=2
TESTIMONIAL_IMAGE_MAX_UPLOAD_SIZE_MB=2
MASTER_MEDIA_PRESIGNED_URL_EXPIRY_SECONDS=300
VENDOR_CONTRACT_EXPIRY_WARNING_DAYS=30
DEFAULT_VENDOR_COUNTRY=IN
DEFAULT_PHONE_COUNTRY=IN
CUSTOMER_DUPLICATE_NAME_THRESHOLD=0.88

# --- Reminders and notifications ----------------------------------
REMINDER_WORKER_BATCH_SIZE=100
REMINDER_WORKER_TIMEZONE_FALLBACK=Asia/Kolkata
REMINDER_ESCALATION_MANAGER_ROLE=Manager
REMINDER_EMAIL_ENABLED=true
REMINDER_DEFAULT_DUE_TIME=10:00
REMINDER_PROCESSING_LOOKAHEAD_DAYS=60
NOTIFICATION_RETENTION_DAYS=180

# --- Rate limiting -------------------------------------------------
# Global limiter. Per-endpoint auth limiters (login, OTP, reset, …) have their
# own tighter budgets in code and are relaxed 10x outside production.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# --- Live search (SearchApi) ---------------------------------------
# Server-level fallback key for https://www.searchapi.io — used only when a
# user has not saved their own per-user key (stored encrypted per user).
# Leave empty to disable the server fallback; users can still add their own
# key from Settings → Live Search.
SEARCHAPI_API_KEY=
SEARCHAPI_BASE_URL=https://www.searchapi.io/api/v1/search

# --- Frontend (Vite) -----------------------------------------------
# Only VITE_-prefixed vars are exposed to the browser bundle. Baked in at BUILD
# time (there is no runtime config for a static SPA). In production this MUST be
# the public https API URL, and web + API should share a registrable domain so
# the SameSite=Lax session cookie is sent (e.g. app.example.com + api.example.com).
VITE_API_URL=http://localhost:4000

# --- System Global Masters bootstrap --------------------------------
# Used only by `npm run bootstrap:system-masters`. The System Admin logs in
# through the normal login page with the configured email and password.
#   - SYSTEM_ADMIN_EMAIL: email of the System Admin account
#   - SYSTEM_ADMIN_PASSWORD: initial System Admin password (required)
#   - SYSTEM_ADMIN_RESET_PASSWORD=true: force the password back to the fixed
#     value on the next bootstrap run (default false — existing password kept)
#   - SYSTEM_GLOBAL_MASTERS_COMPANY_ID: optional fallback company id; normally
#     resolved from the deterministic slug "system-global-masters"
# Provide the real values in ECS / Secrets Manager, never in this file.
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
SYSTEM_ADMIN_RESET_PASSWORD=false
SYSTEM_GLOBAL_MASTERS_COMPANY_ID=
